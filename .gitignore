# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example          # keep the example template committed

# ── Build Output ──────────────────────────────────────────────────────────────
dist/
build/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor & IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── AI / Agent Workspaces ─────────────────────────────────────────────────────
.claude/
.cursor/
.prompt
.gemini/

# ── Supabase Local Dev (needs Docker — not committed) ─────────────────────────
# supabase/.temp/ is already ignored by supabase/.gitignore
# but add an explicit root-level guard in case that inner .gitignore is skipped
supabase/.temp/

# ── Scratch / Temp Work Files ─────────────────────────────────────────────────
scratch/
*.tsc_errors
.sample

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Vite ──────────────────────────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ── Test Coverage ─────────────────────────────────────────────────────────────
coverage/
.vitest-cache/

