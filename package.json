{
  "name": "assessment-core",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite-node scripts/prerender.ts",
    "seo:check": "vite-node scripts/seo-check.ts",
    "dev:workspace": "npm run dev -w @husimi/workspace",
    "build:workspace": "npm run build -w @husimi/workspace",
    "test": "npm run test -w @husimi/workspace"
  },
  "dependencies": {
    "@husimi/brand": "*",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.13.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.7.2",
    "vite": "6.3.5",
    "vitest": "^2.1.9",
    "prettier": "^3.4.2"
  }
}
