{
  "name": "husimi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:website": "npm run dev -w @husimi/website",
    "dev:workspace": "npm run dev -w @husimi/workspace",
    "build": "npm run build --workspaces --if-present",
    "build:website": "npm run build -w @husimi/website",
    "build:workspace": "npm run build -w @husimi/workspace",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @husimi/workspace",
    "seo:check": "npm run seo:check -w @husimi/website"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
